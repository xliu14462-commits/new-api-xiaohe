# 【开发】环境变量

# 应用部署基础路径（如部署在子目录 /admin，则设置为 /admin/）
VITE_BASE_URL = /

# API 请求基础路径（开发环境设置为 / 使用代理，生产环境设置为完整后端地址）
VITE_API_URL = /

# 代理目标地址（开发环境通过 Vite 代理转发请求到此地址，解决跨域问题）
VITE_API_PROXY_URL = http://localhost:8082

# 前端 dev 端口（避免和 new-api 前端 5173 冲突）
VITE_PORT = 5174

# 菜单/权限模式：frontend = 用前端本地静态路由（后端没有菜单接口）
VITE_ACCESS_MODE = frontend

# Delete console
VITE_DROP_CONSOLE = false
